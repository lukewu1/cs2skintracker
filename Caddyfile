services:
  redis:
    command: redis-server --maxmemory 256mb --maxmemory-policy allkeys-lru
    image: redis:7-alpine
    restart: always
    ports:
      - "127.0.0.1:6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  postgres:
    image: postgres:16-alpine
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?required}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?required}
      POSTGRES_DB: ${POSTGRES_DB:-users}
    volumes:
      - pgdata:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB:-users}"]
      interval: 5s
      timeout: 5s
      retries: 10

  api:
    build: ./backend
    restart: always
    environment:
      - CSFLOAT_API_KEY=${CSFLOAT_API_KEY:?required}
      - REDIS_URL=redis://redis:6379
      - DATABASE_URL=postgresql://${POSTGRES_USER:?required}:${POSTGRES_PASSWORD:?required}@postgres:5432/${POSTGRES_DB:-users}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY:?required}
      # Your Vercel production domain, comma-separated if more than one.
      - ALLOWED_ORIGINS=${ALLOWED_ORIGINS:?required}
    ports:
      # Loopback only. Caddy reaches this over the internal network;
      # 127.0.0.1 just lets you curl it while SSH'd in.
      - "127.0.0.1:8000:8000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  caddy:
    image: caddy:2
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data      # certificates live here, don't delete
      - caddy_config:/config
    depends_on:
      - api

volumes:
  pgdata:
  caddy_data:
  caddy_config: